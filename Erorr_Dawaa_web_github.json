      "parameters": {
        "jsCode": "// ===== Expired Lines =====\nconst now = $now.setZone('Africa/Cairo');\nconst rows = $('Read Reservations').all().map(i => i.json);\n\nconst expired = rows.filter(r =>\n  r.status === 'reserved' && r.sku && r.expires_at &&\n  DateTime.fromFormat(String(r.expires_at), 'yyyy-MM-dd H:mm', { zone: 'Africa/Cairo' }) < now\n);\n\nconst seen = {};\nreturn expired.map(r => {\n  const group = String(r.res_id).replace(/-\\d+$/, '');\n  const first = !seen[group];\n  seen[group] = true;\n  return { json: {\n    res_id: r.res_id, group: group, sku: r.sku, name: r.name,\n    qty: Number(r.qty), customer_id: r.customer_id, status: 'expired', first: first\n  } };\n});"
      },
