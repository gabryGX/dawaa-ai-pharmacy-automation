      "parameters": {
        "jsCode": "// ===== Restock Totals =====\nconst now = $now.setZone('Africa/Cairo');\nconst rows = $('Read Reservations').all().map(i => i.json);\n\n// نفس شرط Expired Lines: reserved وعدّى ميعاد الانتهاء\nconst expired = rows.filter(r =>\n  r.status === 'reserved' && r.sku && r.expires_at &&\n  DateTime.fromFormat(String(r.expires_at), 'yyyy-MM-dd H:mm', { zone: 'Africa/Cairo' }) < now\n);\n\nconst cat = {};\nfor (const i of $('Read Catalog').all()) if (i.json.sku) cat[i.json.sku] = Number(i.json.stock) || 0;\n\nconst add = {};\nfor (const r of expired) add[r.sku] = (add[r.sku] || 0) + Number(r.qty);\n\nreturn Object.entries(add).map(([sku, q]) => ({ json: { sku: sku, stock: (cat[sku] || 0) + q } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
