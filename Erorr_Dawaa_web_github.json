    {
      "parameters": {
        "jsCode": "// ===== Find Low Stock: الأصناف اللي مخزونها أقل من 10 =====\nconst LIMIT = 10;\nconst R = '\\u200F';\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst low = $input.all().map(i => i.json)\n  .filter(r => r.sku && Number(r.stock) < LIMIT)\n  .map(r => ({ sku: r.sku, name: r.name, strength: r.strength, stock: Number(r.stock) }))\n  .sort((a, b) => a.stock - b.stock);\n\n// مفيش نواقص: المسار يقف ومفيش رسالة فاضية\nif (!low.length) return [];\n\nconst list = low.map((i, k) =>\n  R + (i.stock === 0 ? '🔴' : '🟡') + ' ' + (k + 1) + '. <b>' + esc(i.name) + '</b> ' + esc(i.strength) + ' — المتبقي: ' + i.stock\n).join('\\n');\n\nconst text = R + '📉 <b>أصناف مخزونها أقل من ' + LIMIT + '</b>\\n'\n  + R + '🕒 ' + $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm') + '\\n\\n'\n  + list + '\\n\\n'\n  + R + '👨‍⚕️ برجاء عمل Restock';\n\nreturn [{ json: { count: low.length, items: low, text: text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        -128
      ],
      "id": "2af00a00-7185-404b-ada6-2f08cd430b23",
      "name": "Find Low Stock"
    },
    {
